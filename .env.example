# Copy to .env (not in git). Read by apps/api, apps/worker and packages/db (migrations).

# PostgreSQL 15+: a database you created (README: CREATE ROLE / CREATE DATABASE), or docker compose (pnpm db:up, port 5433)
DATABASE_URL=postgres://figtest:choose-one@localhost:5432/figtest

# 32 bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts the secrets kept in the database (Figma / GitHub tokens, test logins). Changing it makes them unreadable.
APP_SECRET=

# First admin, created at the first start of the API when there is no user yet
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# API (NestJS) and web (Next.js)
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Uploads, images, reports, git repositories
STORAGE_DIR=./storage

LOG_LEVEL=info

# Tests may open localhost / private addresses (a dev server). Keep false on a shared server (SSRF).
ALLOW_PRIVATE_HOSTS=false
# Jobs of each queue one worker runs at the same time (a run screen = one job)
WORKER_CONCURRENCY=2
# Biggest .fig upload (MB)
MAX_UPLOAD_MB=500
