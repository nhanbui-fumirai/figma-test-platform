{
  "name": "@figtest/figma",
  "version": "0.1.0",
  "private": true,
  "description": "Figma design import: .fig parser (kiwi + zstd) and REST client to one REST-shaped tree, frames list, design area, spec, renderer.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@figtest/contracts": "workspace:*",
    "jszip": "^3.10.1",
    "kiwi-schema": "^0.5.0",
    "playwright": "1.56.0",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "vitest": "^3.2.0"
  }
}
